# Server settings
SERVER_IP=127.0.0.1
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Database settings
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YourDbPassword
DB_NAME=restaurant

# JWT settings
SECRET_KEY=YourJWTSecretKey

# S3-compatible object storage (Parspack / MinIO / etc.)
S3_ENDPOINT_URL=https://s3.parspack.com
S3_ACCESS_KEY_ID=YourAccessKeyId
S3_SECRET_ACCESS_KEY=YourSecretAccessKey
S3_BUCKET_NAME=YourBucketName
S3_REGION=us-east-1

# Legacy file upload settings (kept only for one-time migration script)
UPLOAD_FOLDER=products
CATEGORY_UPLOAD_FOLDER=categories
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp
MAX_CONTENT_LENGTH=5242880

# OpenAI settings
OPENAI_KEY=YourKey
OPENAI_BASEURL=https://api.openai.com/v1

# SMS.ir OTP
SMSIR_API_KEY=YourSmsIrApiKey
SMSIR_TEMPLATE_ID=123456
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_SEND_RATE_LIMIT=3
OTP_SEND_WINDOW_SECONDS=600
OTP_VERIFY_TOKEN_EXPIRY=900


# ZarinPal Payment Gateway
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:8080/api/orders/verify
FRONTEND_URL=http://localhost:4200
