# Server settings
SERVER_IP=127.0.0.1
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Database settings
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YourDbPassword
